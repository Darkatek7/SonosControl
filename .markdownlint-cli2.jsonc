{
  // Keep document globs aligned with .github/workflows/docs-quality.yml and AGENTS.md.
  // The testing guide covers unified schedule/template editing, room stop rules, snapshots, volume limits and artwork fallback.
  "config": {
    "default": true,
    "MD013": false,
    "MD022": false,
    // CHANGELOG.md repeats Added/Changed/Fixed under every version (Keep a Changelog).
    "MD024": { "siblings_only": true },
    "MD031": false,
    "MD032": false,
    "MD033": false,
    "MD034": false,
    "MD058": false,
    "MD060": false
  },
  "globs": [
    "README.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "docs/**/*.md",
    "flydj/*.md",
    "SonosControl.Web/wwwroot/css/README.md"
  ]
}

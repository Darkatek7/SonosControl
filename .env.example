TZ=Europe/Vienna
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
PLAYBACK_PUBLIC_BASE_URL=http://192.168.1.50:8080
PLAYBACK_SESSION_TTL_MINUTES=30

# Live speaker events (on by default). Speakers send changes to PLAYBACK_PUBLIC_BASE_URL, or to
# SONOS_EVENTS_CALLBACK_BASE_URL when set; without a reachable URL the app keeps polling every 5 s.
# SONOS_EVENTS_ENABLED=true
# SONOS_EVENTS_CALLBACK_BASE_URL=http://192.168.1.50:8080

# Docker Hub image tag for docker-compose.hub.yml: latest (default), a release such as 1.2.0, or 1.2 / 1 for the newest matching release.
# SONOSCONTROL_VERSION=latest

# Optional experimental FlyDJ sidecar (off by default). See docs/deploy-and-config.md.
# FLYDJ_ENABLED=true enables it; the sidecar container exits with code 0 while this is false.
FLYDJ_ENABLED=false
# auditory = small baked subgraph (default); full = whole brain (~139k neurons, also baked into the image).
FLYDJ_CONNECTOME_SCOPE=auditory
# Target simulation speed relative to real time in the live view.
FLYDJ_SIM_SPEED=1.0
# Container limits. Use FLYDJ_CPUS=2.0 and FLYDJ_MEM_LIMIT=1g for the full scope.
FLYDJ_CPUS=1.0
FLYDJ_MEM_LIMIT=512m
# Optional shared token between the web app and the sidecar. Uncomment and set a long random value to enable it.
# FLYDJ_SHARED_SECRET=

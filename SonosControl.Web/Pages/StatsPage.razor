@* Routed through InsightsPage. *@
@using System.Globalization
@using SonosControl.Web.Data
@using SonosControl.Web.Services
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "admin,operator,superadmin")]
@inject ApplicationDbContext Db
@inject ConfiguredTimeZoneService AppTimeZone
@inject ILogger<StatsPage> Logger

<div class="listening-insights" aria-busy="@_loading" data-qa="listening-insights">
    <div class="listening-toolbar">
        <div>
            <h2>Listening overview</h2>
            <p>@DateRange · @AppTimeZone.TimeZone.Id · Today is in progress</p>
        </div>
        <div class="listening-controls">
            <label for="listening-period" class="visually-hidden">Listening period</label>
            <select id="listening-period" class="form-select" value="@_dayCount" @onchange="ChangePeriod" disabled="@_loading">
                <option value="7">Last 7 days</option>
                <option value="30">Last 30 days</option>
                <option value="90">Last 90 days</option>
            </select>
            <button type="button" class="btn btn-outline-secondary" @onclick="LoadStats" disabled="@_loading" aria-label="Refresh listening insights">
                <Icon Name="refresh" Size="18" />
            </button>
        </div>
    </div>

    @if (_loading)
    {
        <p class="listening-status" role="status">Loading listening history…</p>
    }
    else if (_error)
    {
        <div class="listening-status" role="alert">
            <p>Listening history could not be loaded. Try refreshing.</p>
            <button type="button" class="btn btn-outline-secondary" @onclick="LoadStats">Try again</button>
        </div>
    }
    else if (_insights is null || _insights.TotalSeconds <= 0)
    {
        <div class="listening-empty">
            <EmptyState IconName="music"
                        Title="No listening recorded in this period"
                        Description="Listening summaries appear after your speakers have played music. Try a longer period to see earlier playback." />
            <a class="btn btn-outline-secondary" href="/insights?tab=activity">View activity log</a>
            <p>Button presses and system events appear in Activity. They do not count as listening time.</p>
        </div>
    }
    else
    {
        @if (_insights.ExcludedOverlapSeconds > 1)
        {
            <p class="listening-method" role="status">Overlapping history detected: @FormatDuration(_insights.ExcludedOverlapSeconds) of duplicate time excluded. Each room counts only once at any moment.</p>
        }
        <section class="listening-summary" aria-label="Listening summary">
            <article class="listening-metric listening-metric--total">
                <span>Recorded listening</span>
                <strong data-qa="listening-total">@FormatDuration(_insights.TotalSeconds)</strong>
                <small>Across all rooms</small>
            </article>
            <article class="listening-metric">
                <span>Days with music</span>
                <strong>@_insights.ActiveDays <small>/ @_dayCount</small></strong>
                <small>Days with recorded playback</small>
            </article>
            <article class="listening-metric">
                <span>Average on listening days</span>
                <strong>@FormatDuration(_insights.AveragePerActiveDay)</strong>
                <small>Across all rooms per active day</small>
            </article>
        </section>

        <section class="listening-panel" aria-labelledby="daily-listening-heading">
            <header class="listening-panel-heading">
                <div>
                    <h3 id="daily-listening-heading">Listening by day</h3>
                    <p>Recorded playback time, including days without recorded playback.</p>
                </div>
                @if (_insights.PeakDay is { } peak)
                {
                    <div class="listening-peak"><span>Most listening</span><strong>@peak.Date.ToString("ddd, d MMM", DisplayCulture) · @FormatDuration(peak.Seconds)</strong></div>
                }
            </header>
            <div class="listening-chart" aria-hidden="true">
                <div class="listening-chart-scale"><span>@FormatAxis(ChartMaximum)</span><span>@FormatAxis(ChartMaximum / 2)</span><span>0</span></div>
                <div class="listening-chart-plot">
                    <div class="listening-chart-bars" style="@($"--day-count: {_dayCount}")">
                        @foreach (var day in _insights.Days)
                        {
                            <div class="listening-chart-column" title="@($"{day.Date.ToString("ddd, d MMM", DisplayCulture)}: {FormatDuration(day.Seconds)}")">
                                <span class="@(day.Date == _insights.PeakDay?.Date ? "is-peak" : "")" style="@Height(day.Seconds)"></span>
                            </div>
                        }
                    </div>
                    <div class="listening-chart-dates"><span>@_insights.Days[0].Date.ToString("d MMM", DisplayCulture)</span><span>@_insights.Days[_dayCount / 2].Date.ToString("d MMM", DisplayCulture)</span><span>Today</span></div>
                </div>
            </div>
            <details class="listening-daily-values">
                <summary>View daily values</summary>
                <table>
                    <caption class="visually-hidden">Recorded listening time per day, across all rooms</caption>
                    <thead><tr><th scope="col">Date</th><th scope="col">Listening time</th></tr></thead>
                    <tbody>
                        @foreach (var day in _insights.Days.Reverse())
                        {
                            <tr><th scope="row">@day.Date.ToString("ddd, d MMM yyyy", DisplayCulture)</th><td>@FormatDuration(day.Seconds)</td></tr>
                        }
                    </tbody>
                </table>
            </details>
        </section>

        <div class="listening-breakdowns">
            <section class="listening-panel" aria-labelledby="rooms-heading">
                <header class="listening-panel-heading"><div><h3 id="rooms-heading">Where music plays</h3><p>Rooms ranked by recorded listening time.</p></div></header>
                @Breakdown(_insights.Rooms)
            </section>
            <section class="listening-panel" aria-labelledby="sources-heading">
                <header class="listening-panel-heading"><div><h3 id="sources-heading">What you listen to</h3><p>Sources as a share of all recorded listening time.</p></div></header>
                @Breakdown(_insights.Sources)
            </section>
        </div>

        @if (_insights.Stations.Count > 0 || _insights.Tracks.Count > 0)
        {
            <div class="listening-breakdowns">
                @if (_insights.Stations.Count > 0)
                {
                    <section class="listening-panel" aria-labelledby="stations-heading">
                        <header class="listening-panel-heading"><div><h3 id="stations-heading">Most listened stations</h3><p>Up to 8 stations, ranked by listening time.</p></div></header>
                        @ContentRanking(_insights.Stations)
                    </section>
                }
                @if (_insights.Tracks.Count > 0)
                {
                    <section class="listening-panel" aria-labelledby="tracks-heading">
                        <header class="listening-panel-heading"><div><h3 id="tracks-heading">Most listened tracks &amp; selections</h3><p>Up to 8 named items, ranked by listening time.</p></div></header>
                        @ContentRanking(_insights.Tracks)
                    </section>
                }
            </div>
        }

        <aside class="listening-method" aria-label="How listening time is counted">
            <Icon Name="clock" Size="18" />
            <div>
                <strong>How this is counted</strong>
                <p>Time is added up per speaker: two rooms playing for an hour count as two hours, including grouped rooms.
                    Overlapping entries for the same room count only once.
                    Playback spanning midnight is split between days in @AppTimeZone.TimeZone.Id.
                    Only saved playback is included; recent playback may take about a minute to appear. Missing history is not estimated.</p>
                <a href="/insights?tab=activity">Review controls and system events in Activity <span aria-hidden="true">→</span></a>
            </div>
        </aside>
    }
</div>

@code {
    private static readonly CultureInfo DisplayCulture = CultureInfo.GetCultureInfo("en-GB");
    private int _dayCount = 30;
    private DateTime _loadedAtUtc = DateTime.UtcNow;
    private ListeningInsights? _insights;
    private bool _loading = true;
    private bool _error;
    private string DateRange => $"{AppTimeZone.ConvertUtc(_loadedAtUtc).Date.AddDays(1 - _dayCount).ToString("d MMM", DisplayCulture)} – {AppTimeZone.ConvertUtc(_loadedAtUtc).ToString("d MMM yyyy", DisplayCulture)}";
    private double ChartMaximum
    {
        get
        {
            var peak = _insights?.PeakDay?.Seconds ?? 0;
            var step = peak <= 300 ? 60 : peak <= 3600 ? 300 : 3600;
            return Math.Max(step, Math.Ceiling(peak / step) * step);
        }
    }

    protected override Task OnInitializedAsync() => LoadStats();

    private async Task ChangePeriod(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var days) && days is 7 or 30 or 90)
        {
            _dayCount = days;
            await LoadStats();
        }
    }

    private async Task LoadStats()
    {
        if (_loading && _insights is not null) return;
        _loading = true;
        _error = false;
        try
        {
            _loadedAtUtc = DateTime.UtcNow;
            var start = AppTimeZone.FromLocal(AppTimeZone.ConvertUtc(_loadedAtUtc).Date.AddDays(1 - _dayCount)).UtcDateTime;
            var history = await Db.PlaybackStats.AsNoTracking()
                .Where(playback => playback.StartTime < _loadedAtUtc && playback.DurationSeconds > 0
                    && playback.StartTime.AddSeconds(playback.DurationSeconds) > start)
                .ToListAsync();
            var settings = _uow.ISettingsRepo is { } repo ? await repo.GetSettings() : null;
            _insights = ListeningInsights.Create(history, settings ?? new SonosSettings(), AppTimeZone, _loadedAtUtc, _dayCount);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load listening insights.");
            _error = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private RenderFragment Breakdown(IReadOnlyList<ListeningBreakdown> items) => @<ul class="listening-bars">
        @foreach (var item in items)
        {
            <li>
                <div class="listening-bar-label"><strong>@item.Name</strong><span>@FormatDuration(item.Seconds) <small>@Percent(item.Seconds)%</small></span></div>
                <div class="listening-bar-track" aria-hidden="true"><span style="@Width(item.Seconds)"></span></div>
            </li>
        }
    </ul>;

    private RenderFragment ContentRanking(IReadOnlyList<ListeningContent> items) => @<ol class="listening-ranking">
        @foreach (var item in items)
        {
            <li>
                <div><strong>@item.Name</strong>@if (!string.IsNullOrWhiteSpace(item.Artist)) { <span>@item.Artist</span> }</div>
                <span class="listening-ranking-time">@FormatDuration(item.Seconds)</span>
            </li>
        }
    </ol>;

    private string Percent(double seconds) => (seconds / (_insights?.TotalSeconds ?? 1) * 100).ToString("0.#", DisplayCulture);
    private string Width(double seconds) => $"width: {(seconds / (_insights?.TotalSeconds ?? 1) * 100).ToString("0.###", CultureInfo.InvariantCulture)}%";
    private string Height(double seconds) => $"height: {(seconds / ChartMaximum * 100).ToString("0.###", CultureInfo.InvariantCulture)}%";

    private static string FormatAxis(double seconds) => seconds >= 3600
        ? $"{(seconds / 3600).ToString("0.#", DisplayCulture)}h"
        : seconds >= 60 ? $"{(seconds / 60).ToString("0.#", DisplayCulture)}m" : $"{seconds:0}s";

    private static string FormatDuration(double seconds)
    {
        if (seconds <= 0) return "0m";
        if (seconds < 60) return "< 1m";
        var minutes = (int)(seconds / 60);
        return minutes >= 60 ? $"{minutes / 60}h {minutes % 60}m" : $"{minutes}m";
    }
}

@inject SettingsEditingService SettingsEditor
@inject ISettingsRepo _settingsRepo
@* Routed through AutomationPage. *@
@using SonosControl.Web.Services
@using System.Globalization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ConfiguredTimeZoneService AppTimeZone
@inject ISceneOrchestrationService SceneOrchestrationService
@attribute [Authorize(Roles = "admin,operator,superadmin")]

<PageTitle>Schedule Windows - Sonos Control</PageTitle>

<div class="schedule-console-shell">
    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert @(_statusIsError ? "alert-danger" : "alert-success") schedule-alert" role="status">@_statusMessage</div>
    }

    @if (_settings is null)
    {
        <section class="schedule-panel schedule-empty-state">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <strong>Loading schedule windows...</strong>
        </section>
    }
    else
    {
        var now = AppTimeZone.Now;
        var active = ScheduleWindowEvaluator.SelectActiveWindow(_settings.ScheduleWindows, now, _settings);

        <section class="schedule-active-strip schedule-active-alert" aria-label="Active schedule window">
            <div>
                <span class="spotify-eyebrow">Live state</span>
                <strong>Active window: @(active?.Name ?? "None")</strong>
            </div>
            <div class="schedule-active-strip__meta">
                <span class="schedule-now-label"><Icon Name="clock" Size="15" /> @AppTimeZone.Format(now, "ddd, dd/MM/yyyy HH:mm")</span>
                <span><Icon Name="scenes" Size="15" /> Playback: @(active is null ? "None" : GetPlaybackName(active))</span>
            </div>
        </section>

        <section class="schedule-workspace">
            <aside class="schedule-panel schedule-list-panel" aria-label="Configured schedule windows">
                <div class="schedule-panel__header">
                    <div>
                        <span class="spotify-eyebrow">Run order</span>
                        <h2><Icon Name="schedule" Size="18" /> Window library</h2>
                    </div>
                    @if (_canManage)
                    {
                        <button type="button" class="btn btn-primary schedule-new-button" @onclick="CreateNewWindow">
                            <Icon Name="plus" Size="16" /> New schedule
                        </button>
                        <button type="button" class="btn btn-outline-primary" @onclick="CreateManualTemplate">Manual template</button>
                    }
                </div>

                @if (_settings.ScheduleWindows.Any())
                {
                    <div class="schedule-window-list">
                        @foreach (var window in ScheduleWindowOrdering.Order(_settings.ScheduleWindows))
                        {
                            <article class="schedule-window-card @GetRowClass(window)">
                                <button type="button" class="schedule-window-card__main schedule-window-select-link" @onclick="() => EditWindow(window)">
                                    <span class="schedule-window-card__icon"><Icon Name="clock" Size="18" /></span>
                                    <span class="schedule-window-card__copy">
                                        <span class="schedule-window-card__title">@window.Name</span>
                                        <span class="schedule-window-card__meta">@(window.HasTimeSchedule ? $"{FormatWindowTimeRange(window)} · {window.RecurrenceType}" : "Manual playback template")</span>
                                        <span class="schedule-window-card__scene">@GetPlaybackName(window)</span>
                                    </span>
                                </button>
                                <div class="schedule-window-card__side">
                                    <span class="schedule-priority-pill" title="Lower priority number runs first">@GetOrderLabel(window) · @window.Priority</span>
                                    <span class="schedule-state-pill @(window.IsEnabled ? "is-enabled" : "is-disabled")">@(window.IsEnabled ? "On" : "Off")</span>
                                    @if (!window.HasTimeSchedule && window.Playback is not null)
                                    {
                                        <button type="button" class="btn btn-outline-success btn-sm schedule-start-now" @onclick="() => StartTemplateNowAsync(window)" disabled="@_isApplying" aria-label="@($"Start now {window.Name}")">Start now</button>
                                    }
                                    @if (_canManage)
                                    {
                                        <div class="schedule-order-actions" aria-label="@($"Reorder {window.Name}")">
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => MoveWindowAsync(window, -1)" disabled="@(GetHumanOrder(window) == 1 || _isSaving)" aria-label="@($"Move {window.Name} earlier")"><Icon Name="chevron-up" Size="14" /></button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => MoveWindowAsync(window, 1)" disabled="@(GetHumanOrder(window) == _settings.ScheduleWindows.Count || _isSaving)" aria-label="@($"Move {window.Name} later")"><Icon Name="chevron-down" Size="14" /></button>
                                        </div>
                                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => RequestDeleteWindow(window)" disabled="@_isSaving" aria-label="@($"Delete {window.Name}")" title="@($"Delete {window.Name}")">
                                            <Icon Name="trash" Size="15" />
                                        </button>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="schedule-empty-state">
                        <Icon Name="schedule" Size="24" />
                        <strong>No schedule windows configured.</strong>
                        <span>Create a schedule or a reusable manual playback template.</span>
                    </div>
                }
            </aside>

            <ResponsiveEditor IsOpen="@(_editingWindow is not null)" Title="Schedule editor"
                              Eyebrow="Builder" CloseLabel="Close schedule editor"
                              PanelClass="schedule-panel schedule-editor-panel" OnClose="CloseEditor">
                <EmptyContent>
                    <div class="schedule-empty-state schedule-muted-alert">
                        <Icon Name="edit" Size="24" />
                        <strong>Select a window or create a new one.</strong>
                        <span>The editor keeps timing, recurrence, playback routing, and fades in one workspace.</span>
                    </div>
                </EmptyContent>
                <ChildContent>
                    @if (_editingWindow is not null)
                    {
                        @if (!string.IsNullOrWhiteSpace(_statusMessage))
                        {
                            <div id="schedule-editor-status" class="alert @(_statusIsError ? "alert-danger" : "alert-success")" role="status" aria-live="polite">@_statusMessage</div>
                        }
                        <div class="schedule-editor-grid" role="group" aria-label="Schedule settings" aria-describedby="@(_statusIsError && !string.IsNullOrWhiteSpace(_statusMessage) ? "schedule-editor-status" : null)">
                        <section class="schedule-editor-card" aria-label="Basic settings">
                            <div class="schedule-editor-card__header">
                                <h3><Icon Name="edit" Size="16" /> Basics</h3>
                                <span>@(_editingWindow.HasTimeSchedule ? FormatWindowTimeRange(_editingWindow) : "Manual template")</span>
                            </div>
                            <div class="schedule-form-grid">
                                <div class="schedule-field schedule-field--wide">
                                    <label for="schedule-name" class="form-label">Name</label>
                                    <input id="schedule-name" class="form-control" @bind="_editingWindow.Name" @bind:event="oninput" disabled="@(!_canManage)" />
                                </div>
                                <div class="schedule-field">
                                    <label for="schedule-time-control" class="form-label">Time control</label>
                                    <div class="form-check form-switch schedule-switch">
                                        <input id="schedule-time-control" class="form-check-input" type="checkbox" role="switch" checked="@_editingWindow.HasTimeSchedule" @onchange="SetTimeControl" aria-describedby="schedule-time-control-help" disabled="@(!_canManage)" />
                                    </div>
                                    <span id="schedule-time-control-help" class="form-text">@(_editingWindow.HasTimeSchedule ? "Runs automatically at the times below." : "Manual template: starts only with Start now.")</span>
                                </div>
                                @if (_editingWindow.HasTimeSchedule)
                                {
                                <div class="schedule-field">
                                    <label for="schedule-enabled" class="form-label">Enabled</label>
                                    <div class="form-check form-switch schedule-switch">
                                        <input id="schedule-enabled" class="form-check-input" type="checkbox" checked="@_editingWindow.IsEnabled" @onchange="SetWindowEnabled" disabled="@(!_canManage)" />
                                    </div>
                                </div>
                                <div class="schedule-field">
                                    <label for="schedule-recurrence" class="form-label">Recurrence</label>
                                    <select id="schedule-recurrence" class="form-select" @bind="_editingWindow.RecurrenceType" disabled="@(!_canManage)">
                                        <option value="@ScheduleRecurrenceType.Daily">Daily</option>
                                        <option value="@ScheduleRecurrenceType.Weekdays">Weekdays</option>
                                        <option value="@ScheduleRecurrenceType.Weekends">Weekends</option>
                                        <option value="@ScheduleRecurrenceType.CustomDays">Custom Days</option>
                                    </select>
                                </div>
                                <div class="schedule-field">
                                    <label for="schedule-start" class="form-label">Start</label>
                                    <input id="schedule-start" class="form-control" type="time" value="@_editingWindow.StartTime.ToString("HH\\:mm")" @onchange="e => SetStartTime(e.Value)" disabled="@(!_canManage)" />
                                </div>
                                <div class="schedule-field">
                                    <label for="schedule-stop" class="form-label">Stop</label>
                                    <input id="schedule-stop" class="form-control" type="time" value="@_editingWindow.StopTime.ToString("HH\\:mm")" @onchange="e => SetStopTime(e.Value)" disabled="@(!_canManage)" />
                                </div>
                                }
                            </div>

                            @if (_editingWindow.HasTimeSchedule && _editingWindow.RecurrenceType == ScheduleRecurrenceType.CustomDays)
                            {
                                <div class="schedule-custom-days" role="group" aria-label="Custom days">
                                    <label class="form-label">Custom days</label>
                                    <div class="schedule-day-grid">
                                        @foreach (var day in Enum.GetValues<DayOfWeek>())
                                        {
                                            <label class="@GetCustomDayButtonClass(day)">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       checked="@_editingWindow.DaysOfWeek.Contains(day)"
                                                       disabled="@(!_canManage)"
                                                       @onchange="e => ToggleCustomDay(day, e.Value)" />
                                                @day.ToString()[..3]
                                            </label>
                                        }
                                    </div>
                                </div>
                            }
                        </section>

                        @if (_editingWindow.Playback is not null)
                        {
                            <PlaybackPayloadEditor Settings="_settings" Playback="_editingWindow.Playback" CanEdit="_canManage" AllowFlyDj="_editingWindow.HasTimeSchedule" OnChanged="PlaybackChanged" />
                        }

                        @if (_editingWindow.HasTimeSchedule && _editingWindow.Playback?.SourceType == SceneSourceType.FlyDj)
                        {
                            <section class="schedule-editor-card schedule-flydj" aria-label="FlyDJ schedule settings" data-qa="schedule-flydj-settings">
                                <h3>FlyDJ</h3>
                                <div class="form-check form-switch">
                                    <input id="schedule-flydj-custom-pool" class="form-check-input" type="checkbox" role="switch" checked="@(_editingWindow.FlyDjCandidateStationUrls is not null)" @onchange="SetFlyDjCustomPool" disabled="@(!_canManage)" />
                                    <label class="form-check-label" for="schedule-flydj-custom-pool">Use a separate station list for this schedule</label>
                                </div>
                                @if (_editingWindow.FlyDjCandidateStationUrls is not null)
                                {
                                    <fieldset class="schedule-flydj-stations">
                                        <legend>Allowed stations</legend>
                                        @foreach (var station in _settings.Stations.Where(station => !string.IsNullOrWhiteSpace(station.Url)))
                                        {
                                            <label class="form-check">
                                                <input class="form-check-input" type="checkbox" checked="@_editingWindow.FlyDjCandidateStationUrls.Contains(station.Url, StringComparer.OrdinalIgnoreCase)" @onchange="args => SetFlyDjStation(station.Url, args.Value is true)" disabled="@(!_canManage)" />
                                                <span>@station.Name</span>
                                            </label>
                                        }
                                    </fieldset>
                                }
                                else { <p class="form-text">Uses the global candidate stations from FlyDJ settings.</p> }
                                <div class="form-check form-switch">
                                    <input id="schedule-flydj-prewarm" class="form-check-input" type="checkbox" role="switch" @bind="_editingWindow.FlyDjPrewarm" disabled="@(!_canManage)" />
                                    <label class="form-check-label" for="schedule-flydj-prewarm">Listen before the schedule starts</label>
                                </div>
                                <p class="form-text">Plans @SonosControl.Web.Services.FlyDj.FlyDjObservationPlan.FromMinutes(_settings.FlyDj.MinDwellMinutes).Window.TotalMinutes.ToString("0.#", CultureInfo.InvariantCulture) minutes of preparation. Speakers start at the scheduled time when enough fresh evidence is available. Slow streams may need longer.</p>
                            </section>
                        }

                        <details class="schedule-editor-card schedule-advanced" data-qa="schedule-advanced">
                            <summary class="schedule-advanced__summary"><h3><Icon Name="timer" Size="16" /> Advanced</h3><span>Priority@(_editingWindow.HasTimeSchedule ? ", dates, fades, exclusions" : "")</span></summary>
                            <div class="schedule-form-grid">
                                <div class="schedule-field">
                                    <label for="schedule-priority" class="form-label">Priority</label>
                                    <input id="schedule-priority" class="form-control" type="number" min="0" max="1000" step="1" @bind="_editingWindow.Priority" aria-describedby="schedule-priority-help" disabled="@(!_canManage)" />
                                    <span id="schedule-priority-help" class="form-text">Lower number takes precedence.</span>
                                </div>
                                @if (_editingWindow.HasTimeSchedule)
                                {
                                <div class="schedule-field">
                                    <label for="schedule-start-date" class="form-label">Start Date (optional)</label>
                                    <input id="schedule-start-date" class="form-control" type="date" value="@DateOnlyToDateInput(_editingWindow.StartDate)" @onchange="e => SetStartDate(e.Value)" disabled="@(!_canManage)" />
                                </div>
                                <div class="schedule-field">
                                    <label for="schedule-end-date" class="form-label">End Date (optional)</label>
                                    <input id="schedule-end-date" class="form-control" type="date" value="@DateOnlyToDateInput(_editingWindow.EndDate)" @onchange="e => SetEndDate(e.Value)" disabled="@(!_canManage)" />
                                </div>
                                <div class="schedule-field">
                                    <label for="schedule-fade-in" class="form-label">Fade In (sec)</label>
                                    <input id="schedule-fade-in" class="form-control" type="number" min="0" max="600" @bind="_editingWindow.FadeInSeconds" disabled="@(!_canManage)" />
                                </div>
                                <div class="schedule-field">
                                    <label for="schedule-fade-out" class="form-label">Fade Out (sec)</label>
                                    <input id="schedule-fade-out" class="form-control" type="number" min="0" max="600" @bind="_editingWindow.FadeOutSeconds" disabled="@(!_canManage)" />
                                </div>
                                }
                            </div>
                            @if (_editingWindow.HasTimeSchedule)
                            {
                                <div class="schedule-exclusions" role="group" aria-label="Excluded dates for this schedule">
                                    <h4>Excluded dates</h4>
                                    <p class="form-text">This schedule skips these days. Global pauses stay under Date exceptions.</p>
                                    @if (_canManage)
                                    {
                                        <div class="schedule-exclusions__add">
                                            <div class="schedule-field">
                                                <label for="schedule-exclusion-date" class="form-label">Excluded date</label>
                                                <input id="schedule-exclusion-date" class="form-control" type="date" value="@_newExclusionDate" @onchange="e => _newExclusionDate = e.Value?.ToString()" />
                                            </div>
                                            <div class="schedule-field">
                                                <label for="schedule-exclusion-repeat" class="form-label">Repeat</label>
                                                <select id="schedule-exclusion-repeat" class="form-select" @bind="_newExclusionRepeat">
                                                    <option value="once">Once</option>
                                                    <option value="yearly">Every year</option>
                                                </select>
                                            </div>
                                            <button type="button" class="btn btn-outline-primary" @onclick="AddExclusion">Add exclusion</button>
                                        </div>
                                    }
                                    @if (_editingWindow.ExcludedDates.Count + _editingWindow.AnnualExcludedDates.Count == 0)
                                    {
                                        <p class="form-text">No excluded dates.</p>
                                    }
                                    else
                                    {
                                        <ul class="schedule-exclusions__list">
                                            @foreach (var date in _editingWindow.ExcludedDates.Order())
                                            {
                                                <li><span>@FormatExclusion(date, false) · Once</span>@if (_canManage) { <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => RemoveExclusion(date, false)" aria-label="@($"Remove excluded date {FormatExclusion(date, false)}")">Remove</button> }</li>
                                            }
                                            @foreach (var date in _editingWindow.AnnualExcludedDates.OrderBy(d => d.Month).ThenBy(d => d.Day))
                                            {
                                                <li><span>@FormatExclusion(date, true) · Every year</span>@if (_canManage) { <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => RemoveExclusion(date, true)" aria-label="@($"Remove yearly excluded date {FormatExclusion(date, true)}")">Remove</button> }</li>
                                            }
                                        </ul>
                                    }
                                </div>
                            }
                        </details>

                        </div>
                    }
                </ChildContent>
                <Actions>
                        @if (_canManage)
                        {
                                <button type="button" class="btn btn-primary" @onclick="SaveWindow" disabled="@_isSaving">
                                    <Icon Name="check" Size="16" /> Save @(_editingWindow?.HasTimeSchedule == true ? "schedule" : "template")
                                </button>
                        }
                </Actions>
            </ResponsiveEditor>
        </section>
    }
</div>

<ConfirmDialog Visible="@(_windowPendingDelete is not null)"
               Title="Delete schedule"
               Message="@($"Delete '{_windowPendingDelete?.Name}'? This cannot be undone.")"
               ConfirmLabel="Delete schedule"
               Dangerous="true"
               OnConfirm="ConfirmDeleteWindowAsync"
               OnCancel="CancelDeleteWindow" />

<UnsavedChangesGuard @ref="_draftGuard" HasChanges="@(_editingWindow is not null && _draftTracker.HasChanges(DraftValues(_editingWindow)))" OnDiscard="DiscardEditor" />

@code {
    private UnsavedChangesGuard? _draftGuard;
    private readonly DraftTracker _draftTracker = new();
    private SonosSettings? _settings;
    private ScheduleWindow? _editingWindow;
    private ScheduleWindow? _originalWindow;
    private ScheduleWindow? _windowPendingDelete;
    private string? _selectedWindowId;
    private string? _statusMessage;
    private bool _statusIsError;
    private bool _isSaving;
    private bool _isApplying;
    private bool _canManage;
    private string? _newExclusionDate;
    private string _newExclusionRepeat = "once";

    private static object? DraftValues(ScheduleWindow? window) => window is null ? null : new
    {
        Window = DraftTracker.Values(window),
        Excluded = window.ExcludedDates.Order(),
        Annual = window.AnnualExcludedDates.Order(),
        window.FlyDjPrewarm,
        FlyDjStations = window.FlyDjCandidateStationUrls?.Order(StringComparer.OrdinalIgnoreCase).ToArray()
    };

    private void SetTimeControl(ChangeEventArgs args)
    {
        if (_editingWindow is null) return;
        // Timing, dates, fades and exclusions stay on the draft while hidden so toggling back restores them.
        _editingWindow.HasTimeSchedule = args.Value is true;
        if (_editingWindow.Playback is not null)
            _editingWindow.Playback.Enabled = !_editingWindow.HasTimeSchedule || _editingWindow.IsEnabled;
    }

    private static string FormatExclusion(DateOnly date, bool annual) =>
        date.ToString(annual ? "dd/MM" : "dd/MM/yyyy", CultureInfo.InvariantCulture);

    private void AddExclusion()
    {
        if (_editingWindow is null || !_canManage) return;
        if (!DateOnly.TryParse(_newExclusionDate, CultureInfo.InvariantCulture, out var date))
        {
            ShowStatus("Choose a date to exclude.", true);
            return;
        }
        var annual = _newExclusionRepeat == "yearly";
        if (annual)
        {
            if (_editingWindow.AnnualExcludedDates.Any(item => item.Month == date.Month && item.Day == date.Day))
            {
                ShowStatus("That yearly exclusion already exists.", true);
                return;
            }
            _editingWindow.AnnualExcludedDates.Add(date);
        }
        else
        {
            if (_editingWindow.ExcludedDates.Contains(date))
            {
                ShowStatus("That date is already excluded.", true);
                return;
            }
            _editingWindow.ExcludedDates.Add(date);
        }
        _newExclusionDate = null;
        _statusMessage = null;
    }

    private void RemoveExclusion(DateOnly date, bool annual)
    {
        if (_editingWindow is null || !_canManage) return;
        if (annual) _editingWindow.AnnualExcludedDates.Remove(date); else _editingWindow.ExcludedDates.Remove(date);
    }

    private string? ValidateDraft(ScheduleWindow window)
    {
        if (string.IsNullOrWhiteSpace(window.Name)) return "Enter a name.";
        if (window.Priority is < 0 or > 1000) return "Priority must be between 0 and 1000.";
        if (!window.HasTimeSchedule && window.Playback?.SourceType == SceneSourceType.FlyDj) return "FlyDJ requires a time schedule. Choose another source for a manual template.";
        if (window.Playback?.SourceType == SceneSourceType.FlyDj && window.FlyDjCandidateStationUrls is { } pool
            && !pool.Any(url => _settings!.Stations.Any(station => string.Equals(station.Url, url, StringComparison.OrdinalIgnoreCase))))
            return "Select at least one available station for this FlyDJ schedule.";
        if (!window.HasTimeSchedule) return null;
        if (window.RecurrenceType == ScheduleRecurrenceType.CustomDays && window.DaysOfWeek.Count == 0) return "Choose at least one day for custom recurrence.";
        if (window.StartDate.HasValue && window.EndDate.HasValue && window.EndDate < window.StartDate) return "End date must be on or after the start date.";
        if (window.FadeInSeconds is < 0 or > 600 || window.FadeOutSeconds is < 0 or > 600) return "Fade values must be between 0 and 600 seconds.";
        return null;
    }

    /// <summary>Manual templates ignore timing, so hidden values that would fail validation are reset instead of blocking the save.</summary>
    private static void NormalizeHiddenTiming(ScheduleWindow window)
    {
        if (window.HasTimeSchedule) return;
        if (window.RecurrenceType == ScheduleRecurrenceType.CustomDays && window.DaysOfWeek.Count == 0) window.RecurrenceType = ScheduleRecurrenceType.Weekdays;
        if (window.StartDate.HasValue && window.EndDate.HasValue && window.EndDate < window.StartDate) window.EndDate = null;
        window.FadeInSeconds = Math.Clamp(window.FadeInSeconds, 0, 600);
        window.FadeOutSeconds = Math.Clamp(window.FadeOutSeconds, 0, 600);
    }

    private static string FormatWindowTimeRange(ScheduleWindow window)
    {
        return $"{window.StartTime:HH\\:mm}-{window.StopTime:HH\\:mm}";
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _canManage = auth.User.IsInRole("admin") || auth.User.IsInRole("superadmin");
        await LoadSettingsAsync();
    }

    private async Task LoadSettingsAsync()
    {
        _settings = await _settingsRepo.GetSettings() ?? new SonosSettings();
        _settings.ScheduleWindows ??= new();
        _settings.Scenes ??= new();
        foreach (var window in _settings.ScheduleWindows)
        {
            window.DaysOfWeek ??= new();
            window.ExcludedDates ??= new();
            window.AnnualExcludedDates ??= new();
        }
    }

    private async Task CreateNewWindow()
    {
        if (_draftGuard is not null && !await _draftGuard.ConfirmDiscardAsync()) return;
        StartNewWindow(hasTimeSchedule: true);
    }

    private async Task CreateManualTemplate()
    {
        if (_draftGuard is not null && !await _draftGuard.ConfirmDiscardAsync()) return;
        StartNewWindow(hasTimeSchedule: false);
    }

    private void StartNewWindow(bool hasTimeSchedule)
    {
        if (!_canManage || _settings is null) return;
        _editingWindow = new ScheduleWindow
        {
            Name = hasTimeSchedule ? $"Schedule {_settings.ScheduleWindows.Count + 1}" : $"Manual template {_settings.ScheduleWindows.Count + 1}",
            HasTimeSchedule = hasTimeSchedule,
            IsEnabled = hasTimeSchedule,
            Priority = 100,
            StartTime = new TimeOnly(6, 0),
            StopTime = new TimeOnly(18, 0),
            RecurrenceType = ScheduleRecurrenceType.Weekdays,
            DaysOfWeek = new(),
            ExcludedDates = new(),
            Playback = CreateDefaultPlayback(hasTimeSchedule),
            FadeInSeconds = 0,
            FadeOutSeconds = 0
        };
        _selectedWindowId = null;
        _originalWindow = null;
        _draftTracker.Accept(DraftValues(_editingWindow));
    }

    private Scene CreateDefaultPlayback(bool hasTimeSchedule) => new()
    {
        Name = hasTimeSchedule ? $"Schedule {_settings?.ScheduleWindows.Count + 1}" : $"Manual template {_settings?.ScheduleWindows.Count + 1}",
        Enabled = true,
        IsSyncedPlayback = true,
        SourceSelectionMode = SceneSourceSelectionMode.Resume,
        Actions = _settings?.Speakers.Select(speaker => new SceneAction
        {
            SpeakerIp = speaker.IpAddress,
            IncludeInPlayback = true,
            Volume = speaker.StartupVolume
        }).ToList() ?? new()
    };

    private void SetFlyDjCustomPool(ChangeEventArgs args)
    {
        if (_editingWindow is null || !_canManage || _settings is null) return;
        _editingWindow.FlyDjCandidateStationUrls = args.Value is true
            ? (_settings.FlyDj.CandidateStationUrls.Count > 0 ? _settings.FlyDj.CandidateStationUrls.ToList() : _settings.Stations.Select(station => station.Url).ToList())
            : null;
    }
    private void SetFlyDjStation(string url, bool selected)
    {
        if (!_canManage || _editingWindow?.FlyDjCandidateStationUrls is not { } pool) return;
        pool.RemoveAll(item => item.Equals(url, StringComparison.OrdinalIgnoreCase));
        if (selected) pool.Add(url);
    }

    private void PlaybackChanged() => StateHasChanged();

    private async Task StartTemplateNowAsync(ScheduleWindow window)
    {
        if (window.Playback is null || _settings is null || SceneTargetResolver.Resolve(window.Playback, _settings).Count == 0)
        {
            ShowStatus("Select at least one speaker in this template.", true);
            return;
        }
        _isApplying = true;
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = auth.User.Identity?.Name ?? "Unknown";
            var playback = CloneScene(window.Playback);
            // An explicit Start now action should work even for migrated templates whose
            // legacy scene was disabled during conversion.
            playback.Enabled = true;
            var result = await SceneOrchestrationService.ApplySceneAsync(playback, user);
            ShowStatus(result.Success ? $"{window.Name} started." : $"Playback failed: {result.Message}", !result.Success);
        }
        catch (Exception ex) { ShowStatus($"Playback failed: {ex.Message}", true); }
        finally { _isApplying = false; }
    }

    private async Task EditWindow(ScheduleWindow window)
    {
        if (_draftGuard is not null && !await _draftGuard.ConfirmDiscardAsync()) return;
        _editingWindow = CloneWindow(window);
        _editingWindow.Playback ??= _settings?.Scenes.FirstOrDefault(scene => scene.Id == window.SceneId) is { } legacyScene ? CloneScene(legacyScene) : CreateDefaultPlayback(window.HasTimeSchedule);
        _originalWindow = CloneWindow(window);
        _selectedWindowId = window.Id;
        _draftTracker.Accept(DraftValues(_editingWindow));
    }

    private async Task SaveWindow()
    {
        if (!_canManage || _settings is null || _editingWindow is null)
        {
            return;
        }

        NormalizeHiddenTiming(_editingWindow);
        if (ValidateDraft(_editingWindow) is { } invalid)
        {
            ShowStatus(invalid, true);
            return;
        }

        if (_editingWindow.Playback is null || SceneTargetResolver.Resolve(_editingWindow.Playback, _settings).Count == 0)
        {
            ShowStatus("Select at least one speaker.", true);
            return;
        }

        _editingWindow.Playback.Name = _editingWindow.Name.Trim();
        _editingWindow.Playback.Enabled = !_editingWindow.HasTimeSchedule || _editingWindow.IsEnabled;

        _isSaving = true;
        try
        {
            _editingWindow.LastModifiedUtc = DateTime.UtcNow;

            _settings = await SettingsEditor.SaveWindowAsync(_editingWindow, _selectedWindowId is null, _originalWindow);
            _selectedWindowId = _editingWindow.Id;
            ShowStatus("Schedule window saved.");
            await LoadSettingsAsync();

            if (!string.IsNullOrWhiteSpace(_selectedWindowId))
            {
                var refreshed = _settings.ScheduleWindows.FirstOrDefault(w => w.Id == _selectedWindowId);
                if (refreshed is not null)
                {
                    _editingWindow = CloneWindow(refreshed);
                    _originalWindow = CloneWindow(refreshed);
                    _draftTracker.Accept(DraftValues(_editingWindow));
                }
            }
        }
        catch (Exception ex)
        {
            ShowStatus($"Failed to save window: {ex.Message}", true);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void RequestDeleteWindow(ScheduleWindow window)
    {
        if (_canManage)
        {
            _windowPendingDelete = window;
        }
    }

    private void CancelDeleteWindow() => _windowPendingDelete = null;

    private async Task CloseEditor()
    {
        if (_isSaving || (_draftGuard is not null && !await _draftGuard.ConfirmDiscardAsync())) return;
        DiscardEditor();
    }

    private void DiscardEditor()
    {
        _editingWindow = null;
        _originalWindow = null;
        _selectedWindowId = null;
        _draftTracker.Accept(null);
    }

    private async Task ConfirmDeleteWindowAsync()
    {
        var window = _windowPendingDelete;
        _windowPendingDelete = null;
        if (!_canManage || _settings is null || window is null)
        {
            return;
        }

        _settings = await SettingsEditor.DeleteWindowAsync(window.Id);
        ShowStatus("Schedule window deleted.");

        if (string.Equals(_selectedWindowId, window.Id, StringComparison.OrdinalIgnoreCase))
        {
            _editingWindow = null;
            _selectedWindowId = null;
        }
    }

    private string GetSceneName(string? sceneId)
    {
        if (string.IsNullOrWhiteSpace(sceneId) || _settings is null)
        {
            return "None";
        }

        return _settings.Scenes.FirstOrDefault(s => s.Id == sceneId)?.Name ?? "Unknown";
    }

    private string GetPlaybackName(ScheduleWindow window) => window.Playback?.Name
        ?? GetSceneName(window.SceneId);

    private void SetWindowEnabled(ChangeEventArgs args)
    {
        if (_editingWindow is null) return;
        _editingWindow.IsEnabled = args.Value is true;
        if (_editingWindow.Playback is not null)
            _editingWindow.Playback.Enabled = !_editingWindow.HasTimeSchedule || _editingWindow.IsEnabled;
    }

    private string GetRowClass(ScheduleWindow window)
    {
        return string.Equals(window.Id, _selectedWindowId, StringComparison.OrdinalIgnoreCase)
            ? "window-selected-row"
            : string.Empty;
    }

    private int GetHumanOrder(ScheduleWindow window)
    {
        if (_settings is null) return 0;
        return ScheduleWindowOrdering.Order(_settings.ScheduleWindows)
            .ToList()
            .FindIndex(item => item.Id == window.Id) + 1;
    }

    private string GetOrderLabel(ScheduleWindow window)
    {
        return GetHumanOrder(window) switch
        {
            1 => "First",
            2 => "Second",
            3 => "Third",
            4 => "Fourth",
            5 => "Fifth",
            6 => "Sixth",
            7 => "Seventh",
            8 => "Eighth",
            9 => "Ninth",
            10 => "Tenth",
            var order => $"Order {order}"
        };
    }

    private async Task MoveWindowAsync(ScheduleWindow window, int direction)
    {
        if (!_canManage || _settings is null || _isSaving) return;
        _isSaving = true;
        try
        {
            _settings = await SettingsEditor.MoveWindowAsync(window.Id, direction);
            if (_editingWindow is not null && _originalWindow is not null)
            {
                var updated = _settings.ScheduleWindows.FirstOrDefault(item => string.Equals(item.Id, _selectedWindowId, StringComparison.OrdinalIgnoreCase));
                if (updated is not null)
                {
                    _editingWindow = SettingsChanges.MergeEntity(updated, _originalWindow, _editingWindow);
                    _originalWindow = CloneWindow(updated);
                }
            }
            ShowStatus($"{window.Name} moved to position {GetHumanOrder(window)}.");
        }
        catch (Exception ex) { ShowStatus($"Failed to move window: {ex.Message}", true); }
        finally { _isSaving = false; }
    }

    private string GetCustomDayButtonClass(DayOfWeek day)
    {
        var selected = _editingWindow?.DaysOfWeek.Contains(day) == true;
        return selected
            ? "btn btn-sm schedule-day-pill is-selected"
            : "btn btn-sm schedule-day-pill";
    }

    private void SetStartTime(object? value)
    {
        if (_editingWindow is null)
        {
            return;
        }

        if (TimeOnly.TryParse(value?.ToString(), out var parsed))
        {
            _editingWindow.StartTime = parsed;
        }
    }

    private void SetStopTime(object? value)
    {
        if (_editingWindow is null)
        {
            return;
        }

        if (TimeOnly.TryParse(value?.ToString(), out var parsed))
        {
            _editingWindow.StopTime = parsed;
        }
    }

    private static string DateOnlyToDateInput(DateOnly? date)
    {
        return date?.ToString("yyyy-MM-dd") ?? string.Empty;
    }

    private void SetStartDate(object? value)
    {
        if (_editingWindow is null)
        {
            return;
        }

        _editingWindow.StartDate = DateOnly.TryParse(value?.ToString(), out var parsed) ? parsed : null;
    }

    private void SetEndDate(object? value)
    {
        if (_editingWindow is null)
        {
            return;
        }

        _editingWindow.EndDate = DateOnly.TryParse(value?.ToString(), out var parsed) ? parsed : null;
    }

    private void ToggleCustomDay(DayOfWeek day, object? value)
    {
        if (_editingWindow is null)
        {
            return;
        }

        var enabled = value is bool b && b;
        if (enabled)
        {
            if (!_editingWindow.DaysOfWeek.Contains(day))
            {
                _editingWindow.DaysOfWeek.Add(day);
            }
        }
        else
        {
            _editingWindow.DaysOfWeek.Remove(day);
        }
    }

    private static ScheduleWindow CloneWindow(ScheduleWindow source)
    {
        return new ScheduleWindow
        {
            Id = source.Id,
            Name = source.Name,
            IsEnabled = source.IsEnabled,
            Priority = source.Priority,
            StartTime = source.StartTime,
            StopTime = source.StopTime,
            RecurrenceType = source.RecurrenceType,
            DaysOfWeek = source.DaysOfWeek?.ToList() ?? new(),
            StartDate = source.StartDate,
            EndDate = source.EndDate,
            ExcludedDates = source.ExcludedDates?.ToList() ?? new(),
            AnnualExcludedDates = source.AnnualExcludedDates?.ToList() ?? new(),
            SceneId = source.SceneId,
            HasTimeSchedule = source.HasTimeSchedule,
            Playback = source.Playback is null ? null : CloneScene(source.Playback),
            FlyDjCandidateStationUrls = source.FlyDjCandidateStationUrls?.ToList(),
            FlyDjPrewarm = source.FlyDjPrewarm,
            FadeInSeconds = source.FadeInSeconds,
            FadeOutSeconds = source.FadeOutSeconds,
            LastModifiedUtc = source.LastModifiedUtc
        };
    }

    private static Scene CloneScene(Scene source) => new()
    {
        Id = source.Id,
        Name = source.Name,
        Description = source.Description,
        Enabled = source.Enabled,
        SourceSelectionMode = source.SourceSelectionMode,
        SourceType = source.SourceType,
        SourceUrl = source.SourceUrl,
        IsSyncedPlayback = source.IsSyncedPlayback,
        MasterSpeakerIp = source.MasterSpeakerIp,
        TimerMinutes = source.TimerMinutes,
        SpeakerIps = source.SpeakerIps?.ToList() ?? new(),
        Actions = source.Actions?.Select(action => new SceneAction
        {
            SpeakerIp = action.SpeakerIp,
            IncludeInPlayback = action.IncludeInPlayback,
            Volume = action.Volume,
            IsMaster = action.IsMaster
        }).ToList() ?? new(),
        LastModifiedUtc = source.LastModifiedUtc
    };

    private void ShowStatus(string message, bool isError = false)
    {
        _statusMessage = message;
        _statusIsError = isError;
    }
}

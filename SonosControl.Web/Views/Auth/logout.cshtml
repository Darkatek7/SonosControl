@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Signing out";
}

<div class="auth-shell">
    <form method="post" action="/auth/logout" class="auth-card">
        @Html.AntiForgeryToken()
        <h2>Signing out</h2>
        <p>You will return to SonosControl shortly.</p>
        <button type="submit" class="btn btn-primary w-100">Continue signing out</button>
    </form>
</div>

<script>
    document.forms[0].submit();
</script>

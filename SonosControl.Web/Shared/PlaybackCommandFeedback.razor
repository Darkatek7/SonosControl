@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="player-command-feedback @Class" role="alert" data-qa="playback-command-error">
        <span>@Message</span>
        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="OnRetry" disabled="@Disabled">Try again</button>
    </div>
}

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
}

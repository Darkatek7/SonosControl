@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

@if (Visible)
{
    <div class="app-dialog-backdrop @(InlineOnDesktop ? "responsive-editor-backdrop" : null) @BackdropClass"
         role="presentation"
         @onclick="HandleBackdropAsync">
        <section class="app-dialog @(InlineOnDesktop ? "responsive-editor-dialog" : null) @SizeClass"
                 role="@(IsModal ? Role : null)"
                 aria-modal="@(IsModal ? "true" : null)"
                 aria-labelledby="@_titleId"
                 aria-describedby="@DescriptionId"
                 tabindex="-1"
                 @ref="_dialogRef"
                 @onkeydown="HandleKeyDownAsync"
                 @onkeydown:stopPropagation="true"
                 @onclick:stopPropagation="true">
            <div class="app-dialog__header">
                <div>
                    @if (!string.IsNullOrWhiteSpace(Eyebrow))
                    {
                        <span class="workspace-eyebrow">@Eyebrow</span>
                    }
                    <h2 id="@_titleId">@Title</h2>
                </div>
                <button type="button"
                        class="btn app-dialog__close"
                        @ref="_closeRef"
                        @onclick="CloseAsync"
                        aria-label="@CloseLabel">
                    <Icon Name="x" Size="18" />
                </button>
            </div>
            <div class="app-dialog__body @BodyClass">
                @ChildContent
            </div>
            @if (FooterContent is not null)
            {
                <div class="app-dialog__actions">
                    @FooterContent
                </div>
            }
        </section>
    </div>
}

@code {
    private readonly string _titleId = $"dialog-title-{Guid.NewGuid():N}";
    private ElementReference _dialogRef;
    private ElementReference _closeRef;
    private bool _focusTrapActive;
    private bool _isMobile;
    private DotNetObjectReference<AccessibleDialog>? _viewportReference;
    private bool IsModal => !InlineOnDesktop || _isMobile;

    [Parameter] public bool Visible { get; set; }
    [Parameter] public bool InlineOnDesktop { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string Role { get; set; } = "dialog";
    [Parameter] public string? DescriptionId { get; set; }
    [Parameter] public string SizeClass { get; set; } = string.Empty;
    [Parameter] public string BackdropClass { get; set; } = string.Empty;
    [Parameter] public string BodyClass { get; set; } = string.Empty;
    [Parameter] public string CloseLabel { get; set; } = "Close dialog";
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible && InlineOnDesktop && _viewportReference is null)
        {
            _viewportReference = DotNetObjectReference.Create(this);
            _isMobile = await JSRuntime.InvokeAsync<bool>("window.sonosUi.observeEditorViewport", _dialogRef, _viewportReference);
            StateHasChanged();
        }
        if (Visible && IsModal && !_focusTrapActive)
        {
            await JSRuntime.InvokeVoidAsync("window.sonosUi.activateFocusTrap", _dialogRef, _closeRef);
            _focusTrapActive = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!Visible && _focusTrapActive)
        {
            await ReleaseFocusTrapAsync();
        }
    }

    private Task HandleBackdropAsync()
        => CloseOnBackdrop ? CloseAsync() : Task.CompletedTask;

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && IsModal
            && await JSRuntime.InvokeAsync<bool>("window.sonosUi.isTopFocusTrap", _dialogRef))
            await CloseAsync();
    }

    private async Task CloseAsync()
    {
        await OnClose.InvokeAsync();
    }

    [JSInvokable]
    public async Task EditorViewportChanged(bool isMobile)
    {
        _isMobile = isMobile;
        if (!IsModal) await ReleaseFocusTrapAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReleaseFocusTrapAsync()
    {
        if (!_focusTrapActive)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("window.sonosUi.releaseFocusTrap", _dialogRef);
        }
        catch (JSDisconnectedException)
        {
        }

        _focusTrapActive = false;
    }

    public async ValueTask DisposeAsync()
    {
        await ReleaseFocusTrapAsync();
        if (_viewportReference is not null)
        {
            try { await JSRuntime.InvokeVoidAsync("window.sonosUi.stopObservingEditorViewport", _dialogRef); }
            catch (JSDisconnectedException) { }
            _viewportReference.Dispose();
        }
    }
}
